<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,user-scalable=no,maximum-scale=1">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="theme-color" content="#050a18">
<title>🍊 JEJU TRIP</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Noto+Sans+KR:wght@400;500;700;900&display=swap');
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
:root{--neon-orange:#ff6a1a;--neon-pink:#ff2d7b;--neon-blue:#00d4ff;--neon-green:#00ff88;--bg:#050a18;}
html,body{height:100%;overflow:hidden;}
body{font-family:'Noto Sans KR',sans-serif;background:var(--bg);color:#fff;overflow:hidden;}

.grid-overlay{
  position:fixed;inset:0;z-index:0;
  background-image:linear-gradient(rgba(0,212,255,.03) 1px,transparent 1px),linear-gradient(90deg,rgba(0,212,255,.03) 1px,transparent 1px);
  background-size:40px 40px;
  mask-image:radial-gradient(ellipse at center,black 30%,transparent 75%);
  -webkit-mask-image:radial-gradient(ellipse at center,black 30%,transparent 75%);
}
.app{position:relative;z-index:1;height:100%;display:flex;flex-direction:column;max-width:480px;margin:0 auto;}

/* TOP */
.topbar{padding:12px 16px 6px;display:flex;align-items:center;justify-content:space-between;flex-shrink:0;}
.logo{font-family:'Orbitron',monospace;font-size:14px;font-weight:900;letter-spacing:3px;color:var(--neon-orange);text-shadow:0 0 8px rgba(255,106,26,.4);}
.logo-sub{font-size:10px;color:rgba(255,255,255,.25);font-weight:500;letter-spacing:1px;margin-top:1px;}
.top-btns{display:flex;gap:6px;}
.top-btn{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);color:rgba(255,255,255,.4);font-size:16px;width:34px;height:34px;border-radius:8px;cursor:pointer;display:flex;align-items:center;justify-content:center;}
.top-btn:active{background:rgba(255,106,26,.15);border-color:rgba(255,106,26,.3);}

/* TABS */
.days{display:flex;gap:4px;padding:4px 12px 8px;flex-shrink:0;}
.day-tab{flex:1;padding:6px 2px;text-align:center;cursor:pointer;background:rgba(255,255,255,.02);border:1px solid rgba(255,255,255,.05);border-radius:10px;font-family:inherit;color:rgba(255,255,255,.25);transition:all .25s;position:relative;overflow:hidden;}
.day-tab::before{content:'';position:absolute;inset:0;border-radius:10px;background:linear-gradient(135deg,var(--neon-orange),var(--neon-pink));opacity:0;transition:opacity .25s;}
.day-tab.active{border-color:rgba(255,106,26,.5);color:#fff;box-shadow:0 0 15px rgba(255,106,26,.2),inset 0 0 15px rgba(255,106,26,.05);}
.day-tab.active::before{opacity:.12;}
.day-tab .dt-l{display:block;font-size:8px;font-weight:700;letter-spacing:1px;opacity:.5;position:relative;z-index:1;}
.day-tab .dt-d{display:block;font-size:14px;font-weight:900;font-family:'Orbitron',monospace;position:relative;z-index:1;margin-top:1px;}
.day-tab .dt-cnt{display:block;font-size:8px;color:var(--neon-orange);opacity:.7;position:relative;z-index:1;margin-top:2px;}

/* MAP */
.map-area{position:relative;flex-shrink:0;height:220px;overflow:hidden;}
.map-svg-wrap{width:100%;height:100%;display:flex;align-items:center;justify-content:center;padding:0 10px;}
.map-svg{width:100%;max-height:100%;overflow:visible;}
.island-fill{fill:rgba(0,212,255,.03);}
.island-stroke{fill:none;stroke:var(--neon-blue);stroke-width:1.8;filter:url(#neonGlow);}
.island-stroke-inner{fill:none;stroke:rgba(0,212,255,.12);stroke-width:.5;}
.route-line{fill:none;stroke:var(--neon-orange);stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round;filter:url(#routeGlow);}
.route-line-bg{fill:none;stroke:rgba(255,106,26,.06);stroke-width:6;stroke-linecap:round;stroke-linejoin:round;}
.stop-g{cursor:pointer;}
.stop-ring{fill:none;stroke:var(--neon-orange);stroke-width:1.5;filter:url(#markerGlow);}
.stop-fill{fill:#050a18;}
.stop-num{fill:var(--neon-orange);font-family:'Orbitron',monospace;font-size:10px;font-weight:700;text-anchor:middle;dominant-baseline:central;}
.stop-g.active .stop-ring{stroke:var(--neon-pink);}
.stop-g.active .stop-num{fill:var(--neon-pink);}
.stop-g.active .stop-fill{fill:rgba(255,45,123,.08);}
.city-label{fill:rgba(0,212,255,.25);font-size:7px;font-weight:700;font-family:'Noto Sans KR';letter-spacing:1px;}
.city-dot{fill:var(--neon-blue);opacity:.25;}
.landmark{fill:rgba(0,255,136,.15);font-size:6px;font-family:'Noto Sans KR';}
.stop-name-label{fill:rgba(255,255,255,.35);font-size:6.5px;font-weight:600;font-family:'Noto Sans KR';}
@keyframes pinPop{from{r:0;opacity:0}to{opacity:1}}

/* PANEL */
.panel{
  flex:1;min-height:0;overflow-y:auto;
  background:linear-gradient(180deg,rgba(8,16,32,.97),rgba(5,10,24,.99));
  border-top:1px solid rgba(0,212,255,.08);
  padding:10px 14px;
  padding-bottom:max(16px,env(safe-area-inset-bottom));
  -webkit-overflow-scrolling:touch;
}
.panel.editing{border-color:rgba(255,106,26,.35);}
.panel-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;position:sticky;top:0;z-index:2;background:rgba(5,10,24,.95);padding:4px 0 6px;}
.panel-title{font-family:'Orbitron',monospace;font-size:10px;font-weight:700;color:var(--neon-orange);text-shadow:0 0 8px rgba(255,106,26,.3);letter-spacing:2px;}
.panel-day{font-size:10px;color:rgba(255,255,255,.25);font-weight:500;}
.panel-filled{font-size:9px;color:var(--neon-blue);font-family:'Orbitron',monospace;}

/* STOP ROW - compact for empty, expanded for filled */
.stop-row{
  display:flex;gap:8px;align-items:flex-start;
  padding:6px 8px;margin-bottom:2px;
  border-radius:10px;cursor:pointer;transition:all .15s;
  border:1px solid transparent;
}
.stop-row:active{background:rgba(255,106,26,.04);}
.stop-row.filled{
  background:rgba(255,255,255,.03);
  border-color:rgba(255,255,255,.05);
  padding:10px 10px;margin-bottom:4px;
}
.stop-row.active-row{border-color:rgba(255,106,26,.3);background:rgba(255,106,26,.05);}

.sr-time{
  font-size:11px;font-weight:600;color:rgba(255,255,255,.2);
  font-family:'Orbitron',monospace;letter-spacing:.5px;
  width:42px;flex-shrink:0;padding-top:2px;
}
.stop-row.filled .sr-time{color:rgba(255,255,255,.4);}
.sr-dot{
  width:6px;height:6px;border-radius:50%;
  background:rgba(255,255,255,.08);flex-shrink:0;
  margin-top:5px;
}
.sr-dot.on{
  width:20px;height:20px;margin-top:0;
  border-radius:50%;border:1.5px solid var(--neon-orange);
  display:flex;align-items:center;justify-content:center;
  font-family:'Orbitron',monospace;font-size:9px;font-weight:700;
  color:var(--neon-orange);background:rgba(255,106,26,.05);
  box-shadow:0 0 8px rgba(255,106,26,.15);
}
.sr-body{flex:1;min-width:0;}
.sr-act{font-size:13px;font-weight:700;color:rgba(255,255,255,.85);}
.sr-empty{font-size:12px;color:rgba(255,255,255,.1);}
.sr-addr{
  display:flex;align-items:center;gap:5px;margin-top:5px;
  background:rgba(0,0,0,.25);border-radius:6px;padding:5px 8px;
  border:1px solid rgba(255,255,255,.04);
}
.sr-addr-txt{font-size:10px;color:rgba(255,255,255,.3);flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.sr-copy{background:var(--neon-orange);color:#000;border:none;border-radius:4px;padding:3px 10px;font-size:10px;font-weight:700;cursor:pointer;font-family:inherit;flex-shrink:0;box-shadow:0 0 6px rgba(255,106,26,.25);}
.sr-copy:active{transform:scale(.95);}
.sr-note{font-size:10px;color:rgba(255,255,255,.18);margin-top:3px;}
.sr-x{background:none;border:none;color:rgba(255,255,255,.12);font-size:16px;cursor:pointer;padding:0 2px;line-height:1;}

/* EDIT */
.edit-wrap{padding:2px 0;}
.edit-head{display:flex;gap:8px;align-items:center;margin-bottom:8px;}
.edit-num{width:28px;height:28px;border-radius:50%;border:1.5px solid var(--neon-orange);display:flex;align-items:center;justify-content:center;font-family:'Orbitron',monospace;font-size:12px;font-weight:700;color:var(--neon-orange);box-shadow:0 0 8px rgba(255,106,26,.2);}
.edit-time{font-size:11px;color:rgba(255,255,255,.3);font-family:'Orbitron',monospace;letter-spacing:1px;}
.edit-wrap input{width:100%;background:rgba(0,0,0,.25);border:1px solid rgba(255,106,26,.2);border-radius:8px;padding:10px 12px;font-size:14px;font-weight:600;color:#fff;outline:none;font-family:inherit;margin-bottom:6px;}
.edit-wrap input:focus{border-color:rgba(255,106,26,.5);box-shadow:0 0 10px rgba(255,106,26,.08);}
.edit-wrap input::placeholder{color:rgba(255,255,255,.12);}
.loc-row{display:flex;gap:4px;flex-wrap:wrap;margin-bottom:8px;}
.loc-chip{padding:3px 9px;border-radius:14px;font-size:10px;font-weight:600;cursor:pointer;background:rgba(0,212,255,.05);border:1px solid rgba(0,212,255,.12);color:rgba(0,212,255,.4);font-family:inherit;transition:all .15s;}
.loc-chip.sel{background:rgba(0,212,255,.12);border-color:rgba(0,212,255,.45);color:var(--neon-blue);box-shadow:0 0 6px rgba(0,212,255,.15);}
.loc-chip:active{transform:scale(.95);}
.edit-addr-row{display:flex;align-items:center;gap:6px;background:rgba(0,0,0,.25);border:1px solid rgba(255,106,26,.2);border-radius:8px;padding:0 12px;margin-bottom:6px;}
.edit-addr-row input{background:transparent;border:none;padding:10px 0;font-size:13px;margin-bottom:0;}
.edit-note{font-size:12px;font-weight:400;color:rgba(255,255,255,.25);}
.edit-btns{display:flex;gap:8px;justify-content:flex-end;margin-top:4px;}
.btn-sv{background:var(--neon-orange);color:#000;border:none;border-radius:8px;padding:9px 24px;font-size:13px;font-weight:700;cursor:pointer;font-family:inherit;box-shadow:0 0 12px rgba(255,106,26,.25);}
.btn-sv:active{transform:scale(.95);}
.btn-cn{background:rgba(255,255,255,.06);color:rgba(255,255,255,.4);border:none;border-radius:8px;padding:9px 16px;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit;}

/* TOAST */
.toast{position:fixed;top:60px;left:50%;transform:translateX(-50%);background:rgba(255,106,26,.95);color:#000;padding:8px 24px;border-radius:20px;font-size:12px;font-weight:700;z-index:100;box-shadow:0 0 20px rgba(255,106,26,.5);animation:toastIn .3s cubic-bezier(.175,.885,.32,1.275);}
@keyframes toastIn{from{opacity:0;transform:translateX(-50%) translateY(-10px) scale(.9);}}

/* MODAL */
.modal-bg{position:fixed;inset:0;background:rgba(0,0,0,.6);backdrop-filter:blur(4px);z-index:50;display:flex;align-items:flex-end;justify-content:center;animation:fadeIn .2s;}
@keyframes fadeIn{from{opacity:0;}}
.modal{background:linear-gradient(180deg,#101828,#0a1020);border:1px solid rgba(0,212,255,.1);border-radius:20px 20px 0 0;padding:24px 20px 36px;width:100%;max-width:480px;animation:slideUp .3s ease;}
@keyframes slideUp{from{transform:translateY(100%);}}
.modal h3{font-family:'Orbitron',monospace;font-size:14px;font-weight:700;color:var(--neon-orange);text-shadow:0 0 8px rgba(255,106,26,.3);margin-bottom:12px;letter-spacing:2px;}
.modal p{font-size:13px;color:rgba(255,255,255,.4);margin-bottom:14px;line-height:1.6;}
.modal textarea{width:100%;height:80px;background:rgba(0,0,0,.3);border:1px solid rgba(255,255,255,.08);border-radius:10px;padding:12px;font-size:11px;font-family:monospace;color:rgba(255,255,255,.5);resize:none;outline:none;}
.modal textarea:focus{border-color:rgba(255,106,26,.3);}
.modal-btns{display:flex;gap:8px;margin-top:14px;}
.m-btn{flex:1;padding:13px;border:none;border-radius:12px;font-size:14px;font-weight:700;cursor:pointer;font-family:inherit;}
.m-btn.pri{background:var(--neon-orange);color:#000;box-shadow:0 0 15px rgba(255,106,26,.3);}
.m-btn.sec{background:rgba(255,255,255,.06);color:rgba(255,255,255,.4);}
</style>
</head>
<body>
<div class="grid-overlay"></div>
<div id="app"></div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/react/18.2.0/umd/react.production.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/react-dom/18.2.0/umd/react-dom.production.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/babel-standalone/7.23.9/babel.min.js"></script>
<script type="text/babel">
const{useState,useEffect,useRef}=React;
const SK="jeju-2026-v4";
const DAYS=[
  {id:1,tab:"02",date:"6/2 화",label:"DAY1",desc:"출발→완도"},
  {id:2,tab:"03",date:"6/3 수",label:"DAY2",desc:"제주"},
  {id:3,tab:"04",date:"6/4 목",label:"DAY3",desc:"제주"},
  {id:4,tab:"05",date:"6/5 금",label:"DAY4",desc:"제주"},
  {id:5,tab:"06",date:"6/6 토",label:"DAY5",desc:"복귀"},
];
const LOCS=[
  {name:"제주공항",x:222,y:82},{name:"제주시",x:240,y:100},{name:"함덕",x:300,y:78},
  {name:"애월",x:165,y:95},{name:"협재",x:120,y:120},{name:"한림",x:105,y:135},
  {name:"중문",x:190,y:220},{name:"서귀포",x:250,y:230},{name:"성산",x:385,y:135},
  {name:"우도",x:420,y:105},{name:"표선",x:350,y:190},{name:"완도항",x:240,y:15},
  {name:"한라산",x:245,y:155},{name:"월정리",x:320,y:82},{name:"김녕",x:330,y:85},
  {name:"조천",x:280,y:80},{name:"대정",x:110,y:200},{name:"모슬포",x:130,y:215},
];
const locMap={};LOCS.forEach(l=>{locMap[l.name]={x:l.x,y:l.y};});
const defaultLoc=(i)=>{
  const p=[{x:240,y:100},{x:165,y:95},{x:300,y:78},{x:120,y:135},{x:190,y:220},{x:250,y:230},{x:385,y:135},{x:350,y:190},{x:420,y:105},{x:280,y:80},{x:130,y:215},{x:110,y:200}];
  return p[i%p.length];
};

// 07:00 ~ 23:00 every hour = 17 slots
const makeHours=()=>{
  const s=[];
  for(let h=7;h<=23;h++) s.push({t:`${String(h).padStart(2,"0")}:00`,a:"",n:"",d:"",loc:""});
  return s;
};

const makeStops=(id)=>{
  const s=makeHours();
  if(id===1){
    s[1]={...s[1],a:"🚗 출발",n:""};        // 08:00
    s[5]={...s[5],a:"🍚 점심",n:"휴게소"};   // 12:00
    s[7]={...s[7],a:"⚓ 완도항 도착",d:"전남 완도군 완도읍 장보고대로 330",loc:"완도항"}; // 14:00
  }
  if(id===5){
    s[7]={...s[7],a:"🚗 서울 복귀"};  // 14:00
  }
  return s;
};

const buildDef=()=>{const o={};DAYS.forEach(d=>{o[d.id]=makeStops(d.id)});return o;};
const load=()=>{try{const d=localStorage.getItem(SK);return d?JSON.parse(d):buildDef();}catch{return buildDef();}};
const persist=(d)=>{try{localStorage.setItem(SK,JSON.stringify(d));}catch{}};

const ISLAND="M160,100 C140,92 120,90 105,100 C88,112 78,128 82,148 C86,168 100,185 120,198 C140,210 165,220 190,228 C215,235 240,238 260,237 C280,236 300,232 320,224 C340,216 358,205 372,190 C386,175 396,158 400,140 C404,122 400,108 390,98 C378,86 362,80 342,78 C322,76 300,78 280,82 C260,86 240,88 220,88 C200,88 180,92 168,96 Z";

function NeonMap({filledStops,activeMapIdx,onTapMapStop,day}){
  const getPos=(s,fi)=>{
    if(s.loc&&locMap[s.loc])return locMap[s.loc];
    for(const l of LOCS){if((s.a||"").includes(l.name))return{x:l.x,y:l.y};}
    return defaultLoc(fi);
  };
  const positions=filledStops.map((s,i)=>getPos(s,i));
  const routePath=positions.length>1?"M"+positions.map(p=>`${p.x},${p.y}`).join(" L "):"";

  return(
    <svg className="map-svg" viewBox="0 0 480 270" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <filter id="neonGlow"><feGaussianBlur stdDeviation="3" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
        <filter id="routeGlow"><feGaussianBlur stdDeviation="4" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
        <filter id="markerGlow"><feGaussianBlur stdDeviation="2" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
      </defs>
      <path d={ISLAND} className="island-fill"/>
      <path d={ISLAND} className="island-stroke"/>
      <path d={ISLAND} className="island-stroke-inner"/>
      <polygon points="225,165 245,128 265,165" fill="none" stroke="rgba(0,255,136,.1)" strokeWidth="1"/>
      <text x="245" y="172" textAnchor="middle" className="landmark">한라산</text>
      {LOCS.filter(l=>!["완도항","한라산"].includes(l.name)).map(l=>(
        <g key={l.name}><circle cx={l.x} cy={l.y} r="1.5" className="city-dot"/>
        <text x={l.x} y={l.y-5} textAnchor="middle" className="city-label">{l.name}</text></g>
      ))}
      {routePath&&<><path d={routePath} className="route-line-bg"/><path d={routePath} className="route-line"/></>}
      {positions.map((p,i)=>(
        <g key={`${day}-${i}`} className={`stop-g ${activeMapIdx===i?"active":""}`} onClick={()=>onTapMapStop(i)}>
          <circle cx={p.x} cy={p.y} r="13" className="stop-ring"/>
          <circle cx={p.x} cy={p.y} r="11" className="stop-fill"/>
          <text x={p.x} y={p.y} className="stop-num">{i+1}</text>
          <text x={p.x} y={p.y+20} textAnchor="middle" className="stop-name-label">
            {filledStops[i].a.replace(/[\p{Emoji_Presentation}]/gu,"").trim().slice(0,6)}
          </text>
        </g>
      ))}
      {filledStops.length===0&&(
        <text x="240" y="155" textAnchor="middle" fill="rgba(255,255,255,.1)" fontSize="11" fontWeight="600" fontFamily="Noto Sans KR">일정을 추가하면 경로가 나타나요</text>
      )}
    </svg>
  );
}

function App(){
  const[day,setDay]=useState(1);
  const[all,setAll]=useState(load);
  const[activeIdx,setActiveIdx]=useState(null); // index in full slots array
  const[editIdx,setEditIdx]=useState(null);
  const[dr,setDr]=useState({a:"",n:"",d:"",loc:""});
  const[toast,setToast]=useState(null);
  const[modal,setModal]=useState(null);
  const[imp,setImp]=useState("");
  const tr=useRef(null);
  const panelRef=useRef(null);
  const show=(m)=>{setToast(m);if(tr.current)clearTimeout(tr.current);tr.current=setTimeout(()=>setToast(null),1800);};
  useEffect(()=>{persist(all);},[all]);

  const slots=all[day];
  const filledStops=slots.filter(s=>s.a);
  const filledCount=filledStops.length;

  // Map active index (in filled array) to full slot index
  const filledToSlotIdx=(fi)=>slots.findIndex((s,i)=>s.a&&slots.slice(0,i+1).filter(x=>x.a).length===fi+1);

  const onTapMapStop=(mapIdx)=>{
    const slotIdx=filledToSlotIdx(mapIdx);
    setActiveIdx(slotIdx);
    // Scroll to that card
    setTimeout(()=>{
      const el=document.getElementById(`slot-${slotIdx}`);
      if(el)el.scrollIntoView({behavior:"smooth",block:"center"});
    },50);
  };

  const startEdit=(i)=>{
    const s=slots[i];
    setEditIdx(i);setActiveIdx(i);
    setDr({a:s.a,n:s.n,d:s.d,loc:s.loc||""});
  };
  const save=()=>{
    if(editIdx===null)return;
    setAll(p=>{const c={...p};c[day]=[...c[day]];c[day][editIdx]={...c[day][editIdx],a:dr.a,n:dr.n,d:dr.d,loc:dr.loc};return c;});
    setEditIdx(null);
  };
  const clr=(i,e)=>{
    e&&e.stopPropagation();
    setAll(p=>{const c={...p};c[day]=[...c[day]];c[day][i]={...c[day][i],a:"",n:"",d:"",loc:""};return c;});
    setEditIdx(null);setActiveIdx(null);
  };
  const cpAddr=(addr,e)=>{
    e&&e.stopPropagation();
    navigator.clipboard.writeText(addr).then(()=>show("주소 복사됨! 📋")).catch(()=>{const t=document.createElement("textarea");t.value=addr;document.body.appendChild(t);t.select();document.execCommand("copy");document.body.removeChild(t);show("복사됨!");});
  };
  const exprt=()=>{const enc=btoa(unescape(encodeURIComponent(JSON.stringify(all))));navigator.clipboard.writeText(enc).then(()=>{show("카톡으로 공유! 💌");setModal(null);}).catch(()=>{const t=document.createElement("textarea");t.value=enc;document.body.appendChild(t);t.select();document.execCommand("copy");document.body.removeChild(t);show("복사됨!");setModal(null);});};
  const imprt=()=>{try{setAll(JSON.parse(decodeURIComponent(escape(atob(imp.trim())))));show("완료! ✅");setModal(null);setImp("");}catch{show("오류 😢");}};
  const reset=()=>{if(confirm("전체 초기화?")){setAll(buildDef());show("초기화");setActiveIdx(null);setEditIdx(null);}};

  // Get map active index (in filled array) from activeIdx
  const activeMapIdx=activeIdx!==null&&slots[activeIdx]?.a?slots.slice(0,activeIdx+1).filter(s=>s.a).length-1:null;

  return(
    <div className="app">
      {toast&&<div className="toast">{toast}</div>}
      {modal&&(<div className="modal-bg" onClick={()=>setModal(null)}><div className="modal" onClick={e=>e.stopPropagation()}>
        {modal==="export"?(<><h3>📤 SEND</h3><p>복사 후 카톡으로 보내세요!</p><div className="modal-btns"><button className="m-btn pri" onClick={exprt}>데이터 복사</button><button className="m-btn sec" onClick={()=>setModal(null)}>닫기</button></div></>)
        :(<><h3>📥 IMPORT</h3><p>받은 데이터 붙여넣기!</p><textarea value={imp} onChange={e=>setImp(e.target.value)} placeholder="붙여넣기..."/><div className="modal-btns"><button className="m-btn pri" onClick={imprt}>가져오기</button><button className="m-btn sec" onClick={()=>{setModal(null);setImp("");}}>닫기</button></div></>)}
      </div></div>)}

      <div className="topbar">
        <div><div className="logo">JEJU TRIP</div><div className="logo-sub">2026.06.02 — 06.06</div></div>
        <div className="top-btns">
          <button className="top-btn" onClick={()=>setModal("export")}>📤</button>
          <button className="top-btn" onClick={()=>setModal("import")}>📥</button>
          <button className="top-btn" onClick={reset}>🗑</button>
        </div>
      </div>

      <div className="days">{DAYS.map(d=>{
        const cnt=all[d.id].filter(s=>s.a).length;
        return(<button key={d.id} className={`day-tab ${d.id===day?"active":""}`}
          onClick={()=>{setDay(d.id);setActiveIdx(null);setEditIdx(null);}}>
          <span className="dt-l">{d.label}</span>
          <span className="dt-d">{d.tab}</span>
          {cnt>0&&<span className="dt-cnt">{cnt}개</span>}
        </button>);
      })}</div>

      <div className="map-area"><div className="map-svg-wrap">
        <NeonMap filledStops={filledStops} activeMapIdx={activeMapIdx} onTapMapStop={onTapMapStop} day={day}/>
      </div></div>

      <div className={`panel ${editIdx!==null?"editing":""}`} ref={panelRef}>
        <div className="panel-header">
          <span className="panel-title">SCHEDULE</span>
          <div style={{display:"flex",gap:8,alignItems:"center"}}>
            <span className="panel-filled">{filledCount}개</span>
            <span className="panel-day">{DAYS.find(d=>d.id===day)?.date}</span>
          </div>
        </div>

        {editIdx!==null?(
          <div className="edit-wrap">
            <div className="edit-head">
              <div className="edit-num">{slots.slice(0,editIdx+1).filter(s=>s.a).length||"+"}</div>
              <span className="edit-time">{slots[editIdx].t}</span>
            </div>
            <input value={dr.a} onChange={e=>setDr(d=>({...d,a:e.target.value}))} placeholder="일정 (예: 🍖 흑돼지 삼겹살)" autoFocus onKeyDown={e=>e.key==="Enter"&&save()}/>
            <div className="loc-row">
              {["제주시","애월","함덕","월정리","협재","한림","중문","서귀포","성산","우도","표선","조천"].map(l=>(
                <button key={l} className={`loc-chip ${dr.loc===l?"sel":""}`}
                  onClick={()=>setDr(d=>({...d,loc:d.loc===l?"":l}))}>{l}</button>
              ))}
            </div>
            <div className="edit-addr-row"><span>📍</span><input value={dr.d} onChange={e=>setDr(d=>({...d,d:e.target.value}))} placeholder="주소 (네비용)" onKeyDown={e=>e.key==="Enter"&&save()}/></div>
            <input className="edit-note" value={dr.n} onChange={e=>setDr(d=>({...d,n:e.target.value}))} placeholder="메모 (선택)" onKeyDown={e=>e.key==="Enter"&&save()}/>
            <div className="edit-btns"><button className="btn-sv" onClick={save}>저장</button><button className="btn-cn" onClick={()=>setEditIdx(null)}>취소</button></div>
          </div>
        ):(
          slots.map((s,i)=>{
            const filled=!!s.a;
            const isActive=activeIdx===i;
            const mapNum=filled?slots.slice(0,i+1).filter(x=>x.a).length:0;
            return(
              <div key={i} id={`slot-${i}`}
                className={`stop-row ${filled?"filled":""} ${isActive?"active-row":""}`}
                onClick={()=>startEdit(i)}>
                <span className="sr-time">{s.t}</span>
                {filled?<div className="sr-dot on">{mapNum}</div>:<div className="sr-dot"/>}
                <div className="sr-body">
                  {filled?(<>
                    <div className="sr-act">{s.a}</div>
                    {s.d&&(<div className="sr-addr" onClick={e=>e.stopPropagation()}><span>📍</span><span className="sr-addr-txt">{s.d}</span><button className="sr-copy" onClick={e=>cpAddr(s.d,e)}>복사</button></div>)}
                    {s.n&&<div className="sr-note">{s.n}</div>}
                  </>):(<div className="sr-empty">탭하여 추가</div>)}
                </div>
                {filled&&<button className="sr-x" onClick={e=>clr(i,e)}>×</button>}
              </div>
            );
          })
        )}
      </div>
    </div>
  );
}
ReactDOM.createRoot(document.getElementById("app")).render(<App/>);
</script>
</body>
</html>
